rules_version = '2';

// ALIBANK SECURE STORAGE RULES V1.3 - PRODUCTION STABLE
// Proteksi mutlak untuk dokumen identitas dan aset nasabah AliBank V3.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fungsi pembantu untuk otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.token.email == 'dzulfikaraliridlo@gmail.com' ||
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- Jalur Dokumen KYC (Kritis) ---
    // Menggunakan recursive match {allPaths=**} untuk memastikan akses ke file di dalam folder user
    match /kyc_documents/{userId}/{allPaths=**} {
      // Nasabah hanya bisa akses folder miliknya sendiri
      // Admin bisa akses semua untuk verifikasi
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Bukti Pembayaran ---
    match /payment_proofs/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Avatar Profil ---
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Proteksi Global: Hanya Admin yang bisa menjelajahi seluruh isi bucket di luar jalur di atas
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}