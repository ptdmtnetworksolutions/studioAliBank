rules_version = '2';

// ALIBANK SECURE STORAGE RULES V1.2 - PRODUCTION STABLE
// Proteksi mutlak untuk dokumen identitas dan aset nasabah AliBank V3.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fungsi pembantu untuk otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.token.email == 'dzulfikaraliridlo@gmail.com' ||
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- Jalur Dokumen KYC (Kritis) ---
    match /kyc_documents/{userId}/{fileName} {
      // Izinkan nasabah mengunggah (create) dan melihat (get) dokumen mereka sendiri.
      // Admin memiliki akses penuh untuk verifikasi.
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Bukti Pembayaran ---
    match /payment_proofs/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Avatar Profil ---
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Proteksi Global: Hanya Admin yang bisa menjelajahi seluruh isi bucket
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}