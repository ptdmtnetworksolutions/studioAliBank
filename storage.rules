rules_version = '2';

// ALIBANK SECURE STORAGE RULES V1.4 - PRODUCTION STABLE
// Proteksi mutlak untuk dokumen identitas dan aset nasabah AliBank V3.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fungsi pembantu untuk otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token != null && 
         'email' in request.auth.token && 
         request.auth.token.email == 'alidzulfikar075@gmail.com'
        )
      );
    }

    // --- Jalur Dokumen KYC (Kritis) ---
    match /kyc_documents/{userId}/{fileName} {
      // Nasabah hanya bisa akses folder miliknya sendiri untuk upload dan read
      // Admin bisa akses semua untuk verifikasi
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Bukti Pembayaran ---
    match /payment_proofs/{userId}/{fileName} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Jalur Avatar Profil ---
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Proteksi Global: Hanya Admin yang bisa menjelajahi seluruh isi bucket di luar jalur di atas
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}