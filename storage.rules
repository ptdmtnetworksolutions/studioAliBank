rules_version = '2';

// ALIBANK SECURE STORAGE RULES V1.0
// Melindungi bukti transfer dan identitas nasabah secara mutlak.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fungsi pembantu untuk otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- Aturan Folder Bukti Pembayaran ---
    match /payment_proofs/{userId}/{allPaths=**} {
      // Nasabah hanya bisa mengunggah dan melihat bukti miliknya sendiri
      allow read, write: if isOwner(userId);
      // Admin punya hak akses penuh untuk verifikasi manual
      allow read, write: if isAdmin();
    }

    // --- Aturan Folder Avatar ---
    match /avatars/{userId}/{allPaths=**} {
      // Foto profil bisa dilihat semua orang (publik) tapi hanya bisa diubah pemilik
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Blokir akses publik tanpa otentikasi ke seluruh bucket
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}