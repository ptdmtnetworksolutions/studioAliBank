rules_version = '2';

// ALIBANK SECURE STORAGE RULES V1.1 - PRODUCTION READY
// Melindungi bukti transfer dan identitas nasabah secara mutlak.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Fungsi pembantu untuk otentikasi
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.token.email == 'dzulfikaraliridlo@gmail.com' ||
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- Aturan Folder Bukti Pembayaran ---
    match /payment_proofs/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Aturan Folder Avatar ---
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- Aturan Folder Dokumen KYC ---
    match /kyc_documents/{userId}/{allPaths=**} {
      // Izinkan nasabah mengunggah identitas mereka sendiri
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Blokir akses publik tanpa otentikasi ke seluruh bucket
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}