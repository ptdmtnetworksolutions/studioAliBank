rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ALIBANK SECURITY RULES V15.0 - HARDENED PRODUCTION SECURITY
     * Melindungi saldo, KYC, dan data pribadi nasabah dari manipulasi sisi klien.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token != null && 
         'email' in request.auth.token && 
         (request.auth.token.email == 'alidzulfikar075@gmail.com' || request.auth.token.email == 'aldzulfikar075@gmail.com')
        )
      );
    }

    function isFieldUnchanged(fieldName) {
      return !(fieldName in request.resource.data) || 
             request.resource.data[fieldName] == resource.data[fieldName];
    }

    function canUserUpdateProfile() {
      return isFieldUnchanged('totalBalance') &&
             isFieldUnchanged('cryptoBalances') &&
             isFieldUnchanged('savings') &&
             isFieldUnchanged('tier') &&
             isFieldUnchanged('isSuspended') &&
             isFieldUnchanged('accountNumber') &&
             isFieldUnchanged('role') &&
             isFieldUnchanged('admin') &&
             // User hanya dapat mengajukan kycStatus 'pending' atau membiarkannya tetap
             (isFieldUnchanged('kycStatus') || request.resource.data.kycStatus == 'pending');
    }

    // --- ROOT LEVEL LIST SUPPORT ---
    match /{topLevelCollection} {
      allow list: if isAdmin();
    }

    // --- GLOBAL ADMIN OVERRIDE ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- DUKUNGAN KUERI LINTAS KOLEKSI (COLLECTION GROUP) ---
    match /{path=**}/transactions/{docId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/invoices/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/futures_positions/{docId} {
      allow read: if isAdmin();
    }

    // --- ATURAN KHUSUS UNTUK NASABAH (NON-ADMIN) ---
    match /users/{userId} {
      // Nasabah hanya dapat membaca profil pribadinya sendiri (kecuali admin)
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Cegah kebocoran massal: hanya admin yang bisa listing seluruh user di Firestore
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Nasabah dilarang memanipulasi saldo, tier, atau status verifikasi langsung dari browser
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && canUserUpdateProfile());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /merchants/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topup_requests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- TRANSAKSI NASABAH ---
    match /transactions/{txId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
    }

    match /market/{pairId} {
      allow read: if isSignedIn();
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
      }
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
    }

    match /system/liquidity {
      allow read: if isSignedIn();
    }
    
    match /system/api_keys {
      allow read, write: if isAdmin();
    }
    
    match /system/public_keys {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /system/audit/{subPath=**} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}