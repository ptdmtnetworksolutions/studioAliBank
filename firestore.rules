
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ALIBANK SECURITY RULES V3.8 - PRODUCTION GRADE
     * Otorisasi dinamis untuk mendukung pencatatan audit otomatis dari sisi klien.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- Aturan Koleksi Nasabah ---
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sub-koleksi Finansial & Utilitas
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Aturan Koleksi Bisnis (Merchant) ---
    match /merchants/{merchantId} {
      allow read, write: if isOwner(merchantId) || isAdmin();
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(merchantId) || isAdmin();
      }
    }

    // --- Aturan Data Pasar (Publik untuk User Terdaftar) ---
    match /market/{pairId} {
      allow read: if isSignedIn();
      match /trades/{tradeId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Aturan Inti Sistem (Vault & Audit) ---
    match /system/liquidity {
      allow read: if isSignedIn();
      // Izinkan user terdaftar memperbarui likuiditas saat transaksi (beli/jual koin)
      allow update: if isSignedIn(); 
      allow create, delete: if isAdmin();
    }
    
    match /system/api_keys {
      allow read, write: if isAdmin();
    }

    match /system/audit/{document=**} {
      allow read: if isAdmin();
      // Izinkan user terdaftar mencatat log transaksi mereka ke audit ledger
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    // --- Aturan Pencarian Global (Collection Group) ---
    match /{path=**}/invoices/{invoiceId} {
      allow read: if isSignedIn();
    }
    
    match /{path=**}/transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
