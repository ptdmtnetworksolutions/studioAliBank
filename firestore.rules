rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ALIBANK SECURITY RULES V13.0 - SUPREME ADMIN & ROOT ACCESS
     * Memberikan kontrol mutlak dan dukungan kueri rekonsiliasi global.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2' ||
        (request.auth.token != null && 
         'email' in request.auth.token && (
           request.auth.token.email == 'alidzulfikar075@gmail.com' || 
           request.auth.token.email == 'dzulfikaraliridlo@gmail.com'
         )
        )
      );
    }

    // --- ROOT LEVEL LIST SUPPORT ---
    match /{topLevelCollection} {
      allow list: if isAdmin();
    }

    // --- GLOBAL ADMIN OVERRIDE (KUASA TANPA BATAS) ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- DUKUNGAN KUERI LINTAS KOLEKSI (COLLECTION GROUP) ---
    match /{path=**}/transactions/{docId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/invoices/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/futures_positions/{docId} {
      allow read: if isAdmin();
    }

    // --- ATURAN KHUSUS UNTUK NASABAH (NON-ADMIN) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /merchants/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topup_requests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /market/{pairId} {
      allow read: if isSignedIn();
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
      }
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
    }

    match /system/liquidity {
      allow read: if isSignedIn();
    }
    
    match /system/api_keys {
      allow read, write: if isAdmin();
    }
    
    match /system/audit/{subPath=**} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}