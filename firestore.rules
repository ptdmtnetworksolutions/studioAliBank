
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ALIBANK SECURITY RULES V4.0 - PRODUCTION GRADE
     * Otorisasi mutlak untuk Super Admin dan izin granular untuk nasabah.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // Global Admin Override: Izin mutlak di seluruh database
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Aturan Koleksi Nasabah ---
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Sub-koleksi Finansial & Utilitas
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Aturan Koleksi Bisnis (Merchant) ---
    match /merchants/{merchantId} {
      allow read, write: if isOwner(merchantId) || isAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isOwner(merchantId) || isAdmin();
      }
    }

    // --- Aturan Data Pasar & Sistem ---
    match /market/{pairId} {
      allow read: if isSignedIn();
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
    }

    match /system/liquidity {
      allow read: if isSignedIn();
      allow update: if isSignedIn(); 
    }
    
    match /system/audit/{subPath=**} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /system/topup_requests/{reqId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}
