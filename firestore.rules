rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ALIBANK SECURITY RULES V10.0 - UNRESTRICTED ADMIN PRIVILEGE
     * Memberikan kontrol penuh tanpa batas kepada Super Admin AliBank.
     * Mengizinkan kueri Collection Group (rekonsiliasi lintas nasabah).
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alidzulfikar075@gmail.com' || 
        request.auth.token.email == 'dzulfikaraliridlo@gmail.com' ||
        request.auth.uid == 'IJOuQpjEOMgvlYfzvQ1yfp976Oa2'
      );
    }

    // --- GLOBAL ADMIN OVERRIDE (CRITICAL) ---
    // Aturan ini mencakup kueri Collection Group dan akses dokumen individual.
    // Jika isAdmin() benar, semua operasi di jalur mana pun akan diizinkan.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- ATURAN KHUSUS UNTUK NASABAH ---
    // (Hanya dievaluasi jika user BUKAN Admin)
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /merchants/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topup_requests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /market/{pairId} {
      allow read: if isSignedIn();
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
      }
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
    }

    match /system/liquidity {
      allow read: if isSignedIn();
    }
    
    match /system/api_keys {
      // Keamanan tertinggi: Hanya Admin yang bisa menyentuh kredensial sistem.
      allow read, write: if isAdmin();
    }
    
    match /system/audit/{subPath=**} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}