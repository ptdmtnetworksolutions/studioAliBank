
/**
 * AliBank V3 Production Security Rules
 * 
 * PROTEKSI MUTLAK:
 * 1. Menghapus Test Mode (Tidak ada masa kedaluwarsa).
 * 2. Otorisasi Super Admin berdasarkan Email: alidzulfikar075@gmail.com
 * 3. Pemisahan Jalur: User-Private vs System-Admin.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Otorisasi berbasis Email Eksklusif untuk Super Admin
      return isSignedIn() && request.auth.token.email == "alidzulfikar075@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- SYSTEM & ADMINISTRATIVE RULES ---

    // Global Liquidity: Semua nasabah bisa lihat status sistem, hanya Admin bisa ubah.
    match /system/liquidity {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit Ledger: Hanya Super Admin yang bisa baca/tulis riwayat operasi global.
    match /system/audit/{document=**} {
      allow read, write: if isAdmin();
    }

    // Roles & Promotion: Jalur khusus untuk Database Access Control.
    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USER & ASSET RULES ---

    match /users/{userId} {
      // Profil: Pemilik bisa akses, Admin bisa mengelola (untuk penyesuaian saldo).
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Subkoleksi (Transactions, Deposits, Wallets, Notifications, etc.)
      match /{allSubcollections=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // --- MERCHANT & BUSINESS RULES ---

    match /merchants/{merchantId} {
      allow read, write: if isOwner(merchantId) || isAdmin();
      
      match /invoices/{invoiceId} {
        allow read: if isSignedIn(); // Izinkan pelanggan baca invoice untuk bayar
        allow write: if isOwner(merchantId) || isAdmin();
      }
    }

    // --- MARKETPLACE & PRODUCTS ---

    match /marketplace/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /depositProducts/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
