
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile and core identity.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accountNumber": { "type": "string" },
        "totalBalance": { "type": "number" },
        "savings": { "type": "number" },
        "walletAddress": { "type": "string" },
        "privateKey": { "type": "string" },
        "cryptoBalances": {
          "type": "object",
          "properties": {
            "ALX": { "type": "number" },
            "USDT": { "type": "number" },
            "ETH": { "type": "number" },
            "BTC": { "type": "number" }
          }
        },
        "tier": { "type": "string" }
      }
    },
    "FuturesPosition": {
      "title": "FuturesPosition",
      "description": "Active leveraged trading position with real balance impact.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "side": { "type": "string", "enum": ["long", "short"] },
        "leverage": { "type": "number" },
        "entryPrice": { "type": "number" },
        "margin": { "type": "number" },
        "platformFee": { "type": "number" },
        "size": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "P2POrder": {
      "title": "P2POrder",
      "description": "Fiat-to-crypto peer transaction record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "type": { "type": "string", "enum": ["buy", "sell"] },
        "asset": { "type": "string" },
        "amountCrypto": { "type": "number" },
        "amountFiat": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "counterpartyName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SystemLiquidity": {
      "title": "SystemLiquidity",
      "description": "Central bank liquidity tracking and revenue monitoring.",
      "type": "object",
      "properties": {
        "totalFiatInjected": { "type": "number" },
        "totalUsdInjected": { "type": "number" },
        "totalTradingFeesIdr": { "type": "number", "description": "Accumulated profit from platform fees." },
        "futuresGrossProfitIdr": { "type": "number", "description": "Revenue from futures liquidations and fees." },
        "tradeXGrossVolumeIdr": { "type": "number" },
        "alixVaultBalance": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "description": "User profile data." }
      },
      {
        "path": "/users/{userId}/futures_positions/{posId}",
        "definition": { "entityName": "FuturesPosition", "description": "Real leveraged positions." }
      },
      {
        "path": "/users/{userId}/p2p_orders/{orderId}",
        "definition": { "entityName": "P2POrder", "description": "User's P2P transaction history." }
      },
      {
        "path": "/system/liquidity",
        "definition": { "entityName": "SystemLiquidity", "description": "Central bank liquidity and profit nodes." }
      }
    ]
  },
  "storage": {
    "buckets": [
      {
        "path": "payment_proofs/{userId}/{fileName}",
        "description": "Real-time deposit and transfer verification images."
      },
      {
        "path": "avatars/{userId}",
        "description": "Client profile identity images."
      }
    ]
  }
}
