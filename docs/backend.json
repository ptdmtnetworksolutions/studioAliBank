
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile and core identity (Shared with Android App).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accountNumber": { "type": "string" },
        "totalBalance": { "type": "number" },
        "savings": { "type": "number" },
        "walletAddress": { "type": "string" },
        "privateKey": { "type": "string" },
        "cryptoBalances": {
          "type": "object",
          "properties": {
            "ALX": { "type": "number" },
            "USDT": { "type": "number" },
            "ETH": { "type": "number" },
            "BTC": { "type": "number" }
          }
        },
        "tier": { "type": "string" }
      }
    },
    "FuturesPosition": {
      "title": "FuturesPosition",
      "description": "Active leveraged trading position.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "side": { "type": "string", "enum": ["long", "short"] },
        "leverage": { "type": "number" },
        "entryPrice": { "type": "number" },
        "margin": { "type": "number" },
        "size": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and transaction notices.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "description": "User profile data." }
      },
      {
        "path": "/users/{userId}/futures_positions/{posId}",
        "definition": { "entityName": "FuturesPosition", "description": "Leveraged positions." }
      },
      {
        "path": "/system/liquidity",
        "definition": { "entityName": "SystemLiquidity", "description": "Central bank liquidity tracking." }
      }
    ]
  }
}
