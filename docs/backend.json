
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile and core identity.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accountNumber": { "type": "string" },
        "totalBalance": { "type": "number" },
        "savings": { "type": "number" },
        "walletAddress": { "type": "string" },
        "tier": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and transaction notices.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SystemLiquidity": {
      "title": "SystemLiquidity",
      "description": "Global bank reserves and stats.",
      "type": "object",
      "properties": {
        "totalFiatInjected": { "type": "number" },
        "totalUsdInjected": { "type": "number" },
        "alixVaultBalance": { "type": "number" },
        "buybackReserveIdr": { "type": "number", "description": "20% of revenue reserved for ALX buyback" },
        "totalAlixBurned": { "type": "number" }
      }
    },
    "SystemAPIKeys": {
      "title": "SystemAPIKeys",
      "description": "Sensitive external API credentials vault.",
      "type": "object",
      "properties": {
        "paypalClientId": { "type": "string" },
        "etherscanApiKey": { "type": "string" },
        "ethereumRpcUrl": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "alxContractAddress": { "type": "string" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "ExternalWallet": {
      "title": "ExternalWallet",
      "description": "Linked external digital wallet.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "balance": { "type": "number" },
        "icon": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "description": "User profile data."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notificationId}",
        "definition": {
          "entityName": "Notification",
          "description": "User notifications."
        }
      },
      {
        "path": "/users/{userId}/transactions/{txId}",
        "definition": {
          "entityName": "Transaction",
          "description": "User transaction history."
        }
      },
      {
        "path": "/users/{userId}/wallets/{walletId}",
        "definition": {
          "entityName": "ExternalWallet",
          "description": "User linked wallets."
        }
      },
      {
        "path": "/system/liquidity",
        "definition": {
          "entityName": "SystemLiquidity",
          "description": "Central bank liquidity tracking."
        }
      },
      {
        "path": "/system/api_keys",
        "definition": {
          "entityName": "SystemAPIKeys",
          "description": "External service credentials."
        }
      }
    ]
  }
}
