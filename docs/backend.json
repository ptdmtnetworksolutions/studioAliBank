
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Informasi profil, saldo utama, saldo aset kripto, dan tautan dompet Web3 pengguna.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "accountNumber": { "type": "string" },
        "totalBalance": { "type": "number" },
        "savings": { "type": "number" },
        "tier": { "type": "string" },
        "walletAddress": { "type": "string", "description": "Alamat dompet MetaMask yang terhubung secara persisten." },
        "cryptoBalances": {
          "type": "object",
          "properties": {
            "BTC": { "type": "number" },
            "ETH": { "type": "number" },
            "USDT": { "type": "number" }
          }
        }
      },
      "required": ["uid", "name", "accountNumber", "email"]
    },
    "MerchantProfile": {
      "title": "Merchant Profile",
      "description": "Profil bisnis untuk pengguna yang bertindak sebagai penjual/merchant.",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "businessName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "category": { "type": "string" },
        "totalRevenue": { "type": "number" },
        "pendingSettlement": { "type": "number" },
        "apiKey": { "type": "string" },
        "webhookUrl": { "type": "string", "description": "URL endpoint untuk notifikasi pembayaran sukses." },
        "status": { "type": "string", "enum": ["active", "suspended", "pending_review"] }
      },
      "required": ["merchantId", "businessName", "ownerUid"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Tagihan pembayaran untuk transaksi B2B.",
      "type": "object",
      "properties": {
        "invoiceId": { "type": "string" },
        "merchantId": { "type": "string" },
        "customerName": { "type": "string" },
        "amountIdr": { "type": "number" },
        "amountUsd": { "type": "number" },
        "amountCrypto": { "type": "number" },
        "cryptoCurrency": { "type": "string", "enum": ["ETH", "USDT", "BTC"] },
        "status": { "type": "string", "enum": ["unpaid", "paid", "expired", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceId", "merchantId", "amountIdr", "status"]
    },
    "MarketplaceItem": {
      "title": "Marketplace Item",
      "description": "Produk yang dijual di Marketplace Crypto.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "priceIdr": { "type": "number" },
        "priceUsd": { "type": "number" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "priceIdr"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi keuangan pengguna.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] }
      },
      "required": ["date", "description", "amount", "type"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notifikasi sistem atau transaksi untuk pengguna.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "read"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Data profil pengguna tunggal."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Riwayat transaksi milik pengguna."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Daftar notifikasi pengguna."
    },
    "/merchants/{merchantId}": {
      "schema": "MerchantProfile",
      "description": "Data bisnis merchant."
    },
    "/merchants/{merchantId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Data tagihan pembayaran merchant."
    },
    "/marketplace/{itemId}": {
      "schema": "MarketplaceItem",
      "description": "Koleksi produk marketplace publik."
    }
  }
}
