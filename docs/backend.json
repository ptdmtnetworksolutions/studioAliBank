
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile and core identity (Shared with Android App).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accountNumber": { "type": "string" },
        "totalBalance": { "type": "number" },
        "savings": { "type": "number" },
        "walletAddress": { "type": "string" },
        "privateKey": { "type": "string", "description": "Encrypted on-device for Android, Server-side for Web" },
        "cryptoBalances": {
          "type": "object",
          "properties": {
            "ALX": { "type": "number" },
            "USDT": { "type": "number" },
            "ETH": { "type": "number" },
            "BTC": { "type": "number" }
          }
        },
        "tier": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and transaction notices (Triggers Push Notification on Android).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SystemLiquidity": {
      "title": "SystemLiquidity",
      "description": "Global bank reserves and stats (Real-time monitoring for Admin).",
      "type": "object",
      "properties": {
        "totalFiatInjected": { "type": "number" },
        "totalUsdInjected": { "type": "number" },
        "alixVaultBalance": { "type": "number" },
        "totalInternalAumIdr": { "type": "number" },
        "totalAlixSoldInternally": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "description": "User profile data."
        }
      },
      {
        "path": "/users/{userId}/transactions/{txId}",
        "definition": {
          "entityName": "Transaction",
          "description": "Individual transaction history."
        }
      },
      {
        "path": "/system/liquidity",
        "definition": {
          "entityName": "SystemLiquidity",
          "description": "Central bank liquidity tracking."
        }
      }
    ]
  }
}
